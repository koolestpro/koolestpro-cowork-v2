<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.koolestpro.git-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/mac/koolestpro-cowork-v2/scripts/git-sync.sh</string>
    </array>

    <!-- Hourly, plus once at login. Pull-then-push, never forces. -->
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>WorkingDirectory</key>
    <string>/Users/mac/koolestpro-cowork-v2</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/mac/koolestpro-cowork-v2/.ai-workflow/git-sync.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mac/koolestpro-cowork-v2/.ai-workflow/git-sync.launchd.log</string>
</dict>
</plist>
