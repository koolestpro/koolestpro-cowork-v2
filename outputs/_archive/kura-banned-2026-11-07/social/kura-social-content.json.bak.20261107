    "TS-KURA-LI-COVER-VID": {
      "platform": [
        "linkedin",
        "instagram"
      ],
      "assetType": "video",
      "assetUrl": "https://res.cloudinary.com/drl0rscuf/video/upload/v1778794527/portfolio/videos/kura-listicle-cover-mp4.mp4",
      "assetPath": null,
      "caption": "The listicle is one of the most underused pages in eCommerce funnels.\n\nMost brands don't build them. The ones that do usually hand them off to a content writer who treats it like a blog post, no CTA flow, no before/after, no conversion architecture.\n\nA listicle done properly does two things at once. First: it earns organic search traffic on problem-aware queries. Second: it moves those people from awareness to purchase without feeling like a sales pitch.\n\nThis is the KURA listicle, built on my li-03 template. The headline: \"5 Problems Your Cutting Board Is Causing Right Now.\" Each problem block follows the same structure: agitate the pain, show what changes, introduce the mechanism. Then the page pivots: transformation strip, social proof, final CTA.\n\nTwo-column alternating layout on desktop. Full single-column collapse on mobile. Inline CTAs at the highest-friction moments.\n\nIf your store is running paid traffic to a product page and wondering why it doesn't convert, this is the page you're missing.\n\nNeed one built for your brand? DM me.\n\n#ecommerce #contentmarketing #CRO #shopify #replo #webdesign #conversionoptimization",
      "hashtags": [],
      "status": "Not Posted",
      "postedAt": null,
      "note": "Cloudinary-hosted only, no local file. Listicle cover video."
    },
    "TS-KURA-LI-COVER-VID-IG": {
      "platform": [
        "instagram"
      ],
      "assetType": "video",
      "assetUrl": "https://res.cloudinary.com/drl0rscuf/video/upload/v1778794527/portfolio/videos/kura-listicle-cover-mp4.mp4",
      "assetPath": null,
      "caption": "Most ecom brands don't have a listicle page.\n\nThe ones that do convert cold traffic at a different rate entirely.\n\nA listicle earns the click from search. Then it earns the sale through the read. Problem → solution → transformation → proof → CTA. In that order. Every time.\n\nThis is the KURA listicle, \"5 Problems Your Cutting Board Is Causing Right Now.\" Looks editorial. Works like a funnel.\n\n→ Full build in the portfolio. Both views in this clip. Need one? DM me.\n\n#ecommerce #CRO #contentmarketing #replo #shopify #webdesign #conversionoptimization",
      "hashtags": [],
      "status": "Not Posted",
