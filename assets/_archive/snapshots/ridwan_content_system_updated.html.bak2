tatus": "Needs Review: brand 'V1CE' not mentioned in LinkedIn caption — check caption matches this asset; claims to verify (1): linkedin: \"...currently backed by 2 reviews  Same product, same...\"; manual-visual-pending: open 9 image(s) to eyeball brand/legibility/framing", "posted_at": ""}], "distributionUpdatedAt": "2026-07-14T16:38:22.362603+00:00"}, {"id": "static-ad-obvi_super-collagen-protein-20260711", "type": "Static Ad", "title": "Obvi Super Collagen Protein — 4-Angle Static Ad Showcase", "slug": "obvi_super-collagen-protein", "status": "Ready", "day": "", "created": "2026-07-11T17:10:00.000Z", "folder": "outputs/static-ads/obvi_super-collagen-protein_20260711/index.html", "week": "Week of July 11", "month": "July 2026", "monthSlug": "2026-07", "reviewedAt": "2026-07-12T00:00:00.000Z", "reviewNote": "Step 8 checklist passed. Disclaimer already present on the review page.", "distribution": [{"post_id": "static-ad-obvi_super-collagen-protein-20260711-20260720-x-1800", "platform": "Twitter", "scheduled_date": "2026-07-20", "scheduled_time_et": "18:00", "status": "Draft", "qa_status": "Needs Review: manual-visual-pending: open 6 image(s) to eyeball brand/legibility/framing", "posted_at": ""}, {"post_id": "static-ad-obvi_super-collagen-protein-20260711-20260725-ig-1200", "platform": "Instagram", "scheduled_date": "2026-07-25", "scheduled_time_et": "12:00", "status": "Draft", "qa_status": "Needs Review: manual-visual-pending: open 6 image(s) to eyeball brand/legibility/framing", "posted_at": ""}, {"post_id": "static-ad-obvi_super-collagen-protein-20260711-20260725-x-1300", "platform": "Twitter", "scheduled_date": "2026-07-25", "scheduled_time_et": "13:00", "status": "Draft", "qa_status": "Needs Review: manual-visual-pending: open 6 image(s) to eyeball brand/legibility/framing", "posted_at": ""}, {"post_id": "static-ad-obvi_super-collagen-protein-20260711-20260726-x-0900", "platform": "Twitter", "scheduled_date": "2026-07-26", "scheduled_time_et": "09:00", "status": "Draft", "qa_status": "Needs Review: manual-visual-pending: open 6 image(s) to eyeball brand/legibility/framing", "posted_at": ""}, {"post_id": "static-ad-obvi_super-collagen-protein-20260711-20260726-ig-1200", "platform": "Instagram", "scheduled_date": "2026-07-26", "scheduled_time_et": "12:00", "status": "Draft", "qa_status": "Needs Review: manual-visual-pending: open 6 image(s) to eyeball brand/legibility/framing", "posted_at": ""}], "distributionUpdatedAt": "2026-07-14T16:38:22.362616+00:00"}, {"id": "tip-the-conversion-layer-1777028149144", "type": "Tip", "title": "The Conversion Layer: Before You Touch Design", "slug": "the-conversion-layer-before-you-touch-design", "status": "Created", "day": "Monday", "created": "2026-04-24T10:55:49.144Z", "folder": "outputs/tips/the-conversion-layer-before-you-touch-design_2026-04-28.html", "week": "Week of Apr 27", "month": "April 2026", "monthSlug": "2026-04"}, {"id": "template-showcase-v1ce_tap-review-card-pdp-20260712", "type": "Template Showcase", "title": "V1CE — Tap Review Card PDP · Template Showcase", "slug": "v1ce_tap-review-card-pdp", "status": "Created", "day": "", "created": "2026-07-12T16:58:00.000Z", "folder": "outputs/templates/v1ce_tap-review-card-pdp_2026-07-12/index.html", "week": "Week of July 12", "month": "July 2026", "monthSlug": "2026-07", "selectionTier": "1B-local-fallback", "selectionNote": "replo-rebuilds not connected this run; showcased koolestpro-cowork-v2's own already-finished V1CE CRO Fix rebuild page (outputs/cro-fixes/v1ce/v1ce_tap-review-card_rebuild_v2.html) per the fallback rule in the task spec.", "assetSetNote": "Device-bezel setup not yet done (first run) — cover.mp4 missing, cover.png/laptop.png/preview.png are placeholder-quality (plain CSS composite, not photoreal bezel). laptop.mp4, mobile.mp4, full.png, mobile-1/2/3.png are full quality.", "captions": {"linkedin": "Built this product page for an NFC review-card brand. No popup gauntlet, no distractions, nothing standing between the visitor and the reason to buy.\n\nPrice sits right under the title. Benefits and bulk pricing follow right after. One CTA. The buyer sees everything they need before they're asked to pick a style or a quantity.\n\nThis is what I build for people launching a new store, whether that's from scratch or a full rebrand.\n\nWant something like this for your brand? DM me.", "x": ["Built this product page for an NFC review-card brand this week: price up top, benefits right after, one CTA, nothing else fighting for attention. This is what day one should look like.", "Founders keep asking me to fix pages built backwards. Here's what building it right the first time looks like.", "Price, benefits, CTA, in that order, no pop-up gauntlet in the way. Launching a store and want this built? DM me."]}, "assets": {"images": ["outputs/templates/v1ce_tap-review-card-pdp_2026-07-12/v1ce_tap-review-card-pdp cover.png", "outputs/templates/v1ce_tap-review-card-pdp_2026-07-12/v1ce_tap-review-card-pdp laptop.png", "outputs/templates/v1ce_tap-review-card-pdp_2026-07-12/v1ce_tap-review-card-pdp full.png", "outputs/templates/v1ce_tap-review-card-pdp_2026-07-12/v1ce_tap-review-card-pdp-mobile-1.png", "outputs/templates/v1ce_tap-review-card-pdp_2026-07-12/v1ce_tap-review-card-pdp-mobile-2.png", "outputs/templates/v1ce_tap-review-card-pdp_2026-07-12/v1ce_tap-review-card-pdp-mobile-3.png", "outputs/templates/v1ce_tap-review-card-pdp_2026-07-12/v1ce_tap-review-card-pdp-preview.png", "outputs/templates/v1ce_tap-review-card-pdp_2026-07-12/v1ce_tap-review-card-pdp-optimized.jpg"], "video": "outputs/templates/v1ce_tap-review-card-pdp_2026-07-12/v1ce_tap-review-card-pdp laptop.mp4"}}, {"id": "template-showcase-kura_hp-01-20260713", "type": "Template Showcase", "title": "KURA Homepage — Full Brand Build Showcase", "slug": "kura_hp-01", "status": "Created", "day": "", "created": "2026-07-13T06:30:00.000Z", "folder": "outputs/templates/kura_hp-01_2026-07-13/index.html", "week": "Week of July 13", "month": "July 2026", "monthSlug": "2026-07", "selectionTier": "1-local-cache", "selectionNote": "Selected from replo-rebuilds-pages.json local sync cache (replo-pages-cache/kura-hp-01/index.html, brand KURA, pageType Homepage, templateId hp-01). replo-rebuilds live folder unreachable this run (same as every prior run) — cache read directly, no cross-project access needed. Manifest entry updated: usedForTemplateShowcase=true, usedForTemplateShowcaseDate=2026-07-13.", "assetSetNote": "All 6 corrected-v2 deliverables produced at full quality with real calibrated device bezels (assets/frames/macbook-pro.svg + iphone-frame.png), no CSS-border fakery. Screenshots captured via a full incremental scroll-through (not a single static shot) so GSAP/IntersectionObserver scroll-reveal animations actually fired before capture. Known limitation: 2 of the 8 sliced bands in full-mosaic.png render as plain dark panels rather than fully revealed content — a couple of scroll-triggered sections needed a longer dwell time than this run's capture pass gave them. Flagged plainly on the review page itself, not hidden.", "captions": {"linkedin": "Built an entire brand from nothing.\n\nNo brief. No identity. No product name. Just a dropship stainless steel cutting board sourced off a supplier page.\n\nI named it KURA. Positioned it for home cooks who take kitchen hygiene seriously. Wrote the tagline (\"Clean Surface. Clear Mind.\"), picked the palette (deep slate, warm cream, burnished copper), and built a three-font type system, display, serif, body, before writing a single line of HTML.\n\nThen I built the homepage. It opens with a preloader that types the brand name in, then reveals: GSAP horizontal scroll on the use-case section, clip-path reveals on the brand imagery, a parallax hero, a marquee trust bar running on pure CSS, scroll-triggered fades on every section via IntersectionObserver. No external JS libraries.\n\nThe goal was never \"nice website.\" It was making a product that costs $48 to source feel like it belongs next to brands spending millions on brand equity. That gap is design. It's copy. It's page speed. It's whether the above-the-fold gives someone a reason to keep reading.\n\nNeed a store like this built for your brand? That's what I do, DM me.\n\n#ecommerce #webdesign #brandstrategy #shopify #replo #CRO #uidesign", "x": ["Built a full brand from scratch for a stainless steel cutting board: name, identity, copy, code.\n\nThis is KURA: \"Clean Surface. Clear Mind.\"\n\nPreloader. GSAP scroll. Clip-path reveals. Zero frameworks.\n\nNeed one for your brand? DM me.\n\n#ecommerce #webdesign #shopify", "KURA homepage, mobile view.\n\nPreloader, hero, trust bar, brand story, product, reviews. All hand-coded, all responsive. Nav collapses clean, scroll animations trigger right, zero layout shift.\n\nWant this built for your store? DM me.\n\n#mobiledesign #ecommerce #webdesign", "Mobile and desktop, one codebase.\n\nKURA was built like a real DTC brand, not a dropship product page. Any product can feel premium. It starts with how you build the page.\n\nNeed a store like this? DMs open.\n\n#ecommerce #shopify #replo #CRO"]}, "assets": {"images": ["outputs/templates/kura_hp-01_2026-07-13/kura_hp-01 cover.png", "outputs/templates/kura_hp-01_2026-07-13/kura_hp-01-preview.png", "outputs/templates/kura_hp-01_2026-07-13/kura_hp-01-full-mosaic.png"], "video": "outputs/templates/kura_hp-01_2026-07-13/kura_hp-01 cover.mp4"}, "distribution": [{"post_id": "template-showcase-kura_hp-01-20260713-20260721-x-0900", "platform": "Twitter", "scheduled_date": "2026-07-21", "scheduled_time_et": "09:00", "status": "Draft", "qa_status": "Needs Review: manual-visual-pending: open 3 image(s) to eyeball brand/legibility/framing", "posted_at": ""}, {"post_id": "template-showcase-kura_hp-01-20260713-20260721-ig-1200", "platform": "Instagram", "scheduled_date": "2026-07-21", "scheduled_time_et": "12:00", "status": "Draft", "qa_status": "Needs Review: manual-visual-pending: open 3 image(s) to eyeball brand/legibility/framing", "posted_at": ""}, {"post_id": "template-showcase-kura_hp-01-20260713-20260723-ig-1200", "platform": "Instagram", "scheduled_date": "2026-07-23", "scheduled_time_et": "12:00", "status": "Draft", "qa_status": "Needs Review: manual-visual-pending: open 3 image(s) to eyeball brand/legibility/framing", "posted_at": ""}, {"post_id": "template-showcase-kura_hp-01-20260713-20260723-x-1300", "platform": "Twitter", "scheduled_date": "2026-07-23", "scheduled_time_et": "13:00", "status": "Draft", "qa_status": "Needs Review: manual-visual-pending: open 3 image(s) to eyeball brand/legibility/framing", "posted_at": ""}, {"post_id": "template-showcase-kura_hp-01-20260713-20260724-li-0900", "platform": "LinkedIn", "scheduled_date": "2026-07-24", "scheduled_time_et": "09:00", "status": "Draft", "qa_status": "Needs Review: manual-visual-pending: open 3 image(s) to eyeball brand/legibility/framing", "posted_at": ""}, {"post_id": "template-showcase-kura_hp-01-20260713-20260724-ig-1200", "platform": "Instagram", "scheduled_date": "2026-07-24", "scheduled_time_et": "12:00", "status": "Draft", "qa_status": "Needs Review: manual-visual-pending: open 3 image(s) to eyeball brand/legibility/framing", "posted_at": ""}, {"post_id": "template-showcase-kura_hp-01-20260713-20260725-x-0900", "platform": "Twitter", "scheduled_date": "2026-07-25", "scheduled_time_et": "09:00", "status": "Draft", "qa_status": "Needs Review: manual-visual-pending: open 3 image(s) to eyeball brand/legibility/framing", "posted_at": ""}], "distributionUpdatedAt": "2026-07-14T16:38:22.362621+00:00"}, {"id": "static-ad-bebemoss_ginger-sleepy-bunny-20260717", "type": "Static Ad", "title": "Bebemoss — Ginger the Sleepy Bunny · 4-Angle Static Ad Showcase", "slug": "bebemoss_ginger-sleepy-bunny", "status": "Created", "day": "", "created": "2026-07-17T15:55:00.000Z", "folder": "outputs/static-ads/bebemoss_ginger-sleepy-bunny_20260717/index.html", "week": "Week of July 17", "month": "July 2026", "monthSlug": "2026-07", "isNew": true, "genNote": "koolestpro-static-ad-weekly buffer run. Fresh target (Bebemoss, zero prior static-ad use). Product photography AI-generated (gpt-image-2, low q, flagged); ad layouts+text composited via PIL because the sandbox 45s command ceiling makes native gpt-image text-overlay renders unreliable. All claims sourced from bebemoss.com + Faire; nothing invented.", "captions": {"linkedin": "Bebemoss sells a $44 crocheted bunny. No discount codes, no countdown timers, no \"10,000 reviews\" banner slapped across the page.\n\nSo I set myself a rule: build 4 ad directions for one of their toys and don't invent a single claim.\n\nWhere each one came from:\n\nProblem: most \"first toys\" are plastic and in a landfill before the kid starts school. This one gets kept.\n\nBenefit: GOTS organic cotton, crocheted by hand, made to EU toy-safety standards. Real specs, no filler.\n\nSocial proof: one actual review, \"she's actually a work of art.\" Plus their 4.9 from wholesale buyers on Faire.\n\nOffer: they have no sale to run, so I told the truth instead. It's made to order, by hand. That's the reason to act, not a fake timer.\n\nSame bunny. Same photo. Four different reasons to care, depending on where the buyer's head is when they see it.\n\nThat's most of the job with ad creative. Not \"make it pop.\" Figure out what the person needs to hear first.\n\nConcept work. I'm not affiliated with Bebemoss, I just liked the product enough to think about how I'd sell it.", "x": ["4 ad directions from one $44 crocheted bunny.\n\nNo fake discounts. No made-up review counts. Every line traces back to something real about the brand.\n\nSame product, 4 different reasons to buy it. That's the whole game.\n\n(concept work, not affiliated with Bebemoss)", "Best social proof isn't \"10,000 reviews.\"\n\nIt's one specific line: \"when she peeked out of the bag, I was amazed, she's actually a work of art.\"\n\nBuilt a whole ad around that one real review. Specific beats big every time.\n\n(concept, not affiliated)", "Bebemoss has no discount to run. So how do you write an \"act now\" ad without lying?\n\nYou don't fake a countdown. You tell the truth: it's crocheted by hand, made to order, not sitting in a warehouse.\n\nReal scarcity does the work a fake timer can't."]}, "assets": {"images": ["outputs/static-ads/bebemoss_ginger-sleepy-bunny_20260717/combined-showcase.png", "outputs/static-ads/bebemoss_ginger-sleepy-bunny_20260717/ad-1-problem-solution.png", "outputs/static-ads/bebemoss_ginger-sleepy-bunny_20260717/ad-2-benefit-result.png", "outputs/static-ads/bebemoss_ginger-sleepy-bunny_20260717/ad-3-social-proof.png", "outputs/static-ads/bebemoss_ginger-sleepy-bunny_20260717/ad-4-offer-urgency.png"], "video": null}}]}</script>
<!-- COWORK_SYNC_DATA_END -->

<script>
  const SYNC_DATA = (() => {
    try {
      return JSON.parse(document.getElementById('cowork-sync-data').textContent);
    } catch (error) {
      return { months: {}, items: [] };
    }
  })();

  function showPage(id, tabEl) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
    document.getElementById('page-' + id).classList.add('active');
    if (tabEl) tabEl.classList.add('active');
  }

  function monthLabelFromSlug(monthSlug) {
    if (!monthSlug) return 'Unknown';
    const parts = monthSlug.split('-').map(Number);
    return new Date(parts[0], parts[1] - 1, 1).toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
  }

  function monthSlugFromLabel(label) {
    if (!label) return '';
    const parsed = new Date(label + ' 01');
    if (Number.isNaN(parsed.getTime())) return '';
    return parsed.getFullYear() + '-' + String(parsed.getMonth() + 1).padStart(2, '0');
  }

  function itemMonthSlug(item) {
    return item.monthSlug || monthSlugFromLabel(item.month) || '';
  }

  function pillarBadgeClass(item) {
    if (item.type === 'CRO Fix' || /conversion/i.test(item.pillar || '')) return 'cro';
    if (item.type === 'Personal' || /builder/i.test(item.pillar || '')) return 'personal';
    if (/craft/i.test(item.pillar || '')) return 'design';
    return 'design';
  }

  function escapeHtml(value) {
    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function renderIdeaBank() {
    const items = Array.isArray(SYNC_DATA.items) ? SYNC_DATA.items.filter(item => itemMonthSlug(item)) : [];
    const months = Object.keys(SYNC_DATA.months || {});
    items.forEach(item => {
      const slug = itemMonthSlug(item);
      if (slug && !months.includes(slug)) months.push(slug);
    });
    months.sort((a, b) => b.localeCompare(a));

    const summary = document.getElementById('idea-bank-summary');
    const monthList = document.getElementById('idea-bank-months');

    if (!items.length) {
      summary.innerHTML = ''
        + '<div class="idea-sum-card"><div class="idea-sum-label">Monthly Sets</div><div class="idea-sum-value">0</div></div>'
        + '<div class="idea-sum-card"><div class="idea-sum-label">Ideas</div><div class="idea-sum-value">0</div></div>'
        + '<div class="idea-sum-card"><div class="idea-sum-label">Hot Priority</div><div class="idea-sum-value">0</div></div>';
      monthList.innerHTML = '<div class="idea-ctrl-card">Run <code>node run_ideas.js</code> to generate the first synced monthly idea set.</div>';
      return;
    }

    summary.innerHTML = ''
      + '<div class="idea-sum-card"><div class="idea-sum-label">Monthly Sets</div><div class="idea-sum-value">' + months.length + '</div></div>'
      + '<div class="idea-sum-card"><div class="idea-sum-label">Ideas</div><div class="idea-sum-value">' + items.length + '</div></div>'
      + '<div class="idea-sum-card"><div class="idea-sum-label">Hot Priority</div><div class="idea-sum-value">' + items.filter(item => item.priority === 'Hot').length + '</div></div>';

    monthList.innerHTML = months.map(monthSlug => {
      const meta = (SYNC_DATA.months || {})[monthSlug] || {};
      const monthItems = items.filter(item => itemMonthSlug(item) === monthSlug);
      return ''
        + '<div class="idea-month-block">'
        +   '<div class="idea-month-head">'
        +     '<div>'
        +       '<div class="idea-month-title">' + escapeHtml(meta.label || monthLabelFromSlug(monthSlug)) + '</div>'
        +       '<div class="idea-month-sub">' + escapeHtml(meta.topic || 'Skill-generated monthly idea set synced from the content pipeline.') + '</div>'
        +     '</div>'
        +     '<div class="idea-month-actions">'
        +       (meta.htmlPath ? '<a class="idea-month-link" href="' + escapeHtml(meta.htmlPath) + '">Go to Ideas</a>' : '')
        +       '<a class="idea-month-link" href="content_pipeline.html">Open Pipeline</a>'
        +     '</div>'
        +   '</div>'
        +   '<div class="idea-month-grid">'
        +     monthItems.map(item => ''
              + '<div class="idea-item' + (item.isNew ? ' new-idea' : (item.status !== 'Idea' ? ' new-idea' : '')) + '">'
              +   '<div class="idea-badges">'
              +     (item.isNew ? '<span class="idea-badge new-badge">NEW</span>' : '')
              +     '<span class="idea-badge ' + pillarBadgeClass(item) + '">' + escapeHtml(item.type || item.pillar || 'Idea') + '</span>'
              +   '</div>'
              +   '<div class="idea-text">'
              +     '<div class="idea-hook">' + escapeHtml(item.title) + '</div>'
              +     '<div class="idea-desc">' + escapeHtml(item.brief || item.angle || item.status || '') + '</div>'
              +     '<span class="idea-format">' + escapeHtml(item.priority || 'Warm') + ' · ' + escapeHtml(item.status || 'Idea') + '</span>'
              +     (item.folder ? '<a href="file:///Users/mac/Downloads/koolestpro-cowork-v2/' + escapeHtml(item.folder) + '" target="_blank" style="display:inline-block;margin-top:8px;font-size:10px;color:#007BFF;text-decoration:none;padding:3px 8px;border:1px solid rgba(0,123,255,0.3);border-radius:5px;letter-spacing:0.5px;" onclick="event.stopPropagation()">⌁ Open file →</a>' : '')
              +   '</div>'
              + '</div>'
            ).join('')
        +   '</div>'
        + '</div>';
    }).join('');
  }

function triggerIdeaGen() {
  const prompt = document.getElementById('new-idea-prompt').value.trim();

  // Collect current month slug
  const now = new Date();
  const currentMonthSlug = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0');
  const currentMonthLabel = now.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

  // Gather existing ideas for this month to prevent duplicates
  const existingThisMonth = (SYNC_DATA.items || []).filter(item => {
    const mSlug = item.monthSlug || monthSlugFromLabel(item.month || '');
    return mSlug === currentMonthSlug;
  });

  const existingList = existingThisMonth.length > 0
    ? '\n\nEXISTING IDEAS FOR ' + currentMonthLabel.toUpperCase() + ' (' + existingThisMonth.length + ' total — DO NOT recreate any of these):\n'
      + existingThisMonth.map((item, i) => (i + 1) + '. [' + (item.type || 'Idea') + '] ' + item.title).join('\n')
    : '';

  const base = 'Run the Koolestpro Idea Generator skill. Target month: ' + currentMonthLabel + ' (' + currentMonthSlug + '). Add new ideas INTO this month — do not start a new month group.';
  const dedup = ' Generate ideas that are NOT in the existing list above. Check titles and angles for overlap before generating.';

  const msg = prompt
    ? base + ' Starting point: "' + prompt + '".' + dedup + existingList
    : base + ' Identify the most underrepresented content pillar (Conversion Strategy / Digital Craftsmanship / Builder\'s Journey) and generate fresh ideas for it.' + dedup + existingList;

  navigator.clipboard.writeText(msg).then(() => {
    const btn = event.target;
    const orig = btn.textContent;
    btn.textContent = '✓ Copied (' + existingThisMonth.length + ' existing ideas included) — paste into Cowork';
    setTimeout(() => btn.textContent = orig, 3500);
  }).catch(() => {
    // Fallback: show in textarea
    document.getElementById('new-idea-prompt').value = msg;
  });
}

renderIdeaBank();

// Populate current month idea count in pipeline sync status
(function() {
  const now = new Date();
  const currentSlug = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0');
  const count = (SYNC_DATA.items || []).filter(item => {
    const mSlug = item.monthSlug || monthSlugFromLabel(item.month || '');
    return mSlug === currentSlug;
  }).length;
  const el = document.getElementById('current-month-count');
  if (el) el.textContent = count;
})();

</script>
</body>
</html>
