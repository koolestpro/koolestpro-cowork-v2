  "image_types": {
    "static-ad-text-heavy": {
      "description": "Ads where text, headlines, CTAs, badges, or quotes are the primary visual element. Typography must be accurate and readable. NOTE: OpenAI is the ONLY provider that reliably renders text correctly. Ideogram is decent but makes spacing/casing errors. FLUX is unusable for readable text.",
      "keywords": ["ad", "advertisement", "headline", "tagline", "cta", "call to action", "banner", "quote", "text overlay", "typography", "reading exactly", "label reading", "reads", "says", "poster", "flyer"],
      "requirements": ["accurate_text", "typography_control", "high_contrast"],
      "tier_ranking": {
        "premium": ["openai_gpt-image-2_high", "openai_gpt-image-2_medium"],
