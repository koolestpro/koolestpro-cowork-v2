# SEO engine keys for THIS project only. Copy to .env at the repo root. Never commit .env.
# Fill in only what this project uses; every tool skips what's missing and says so.

# Google sign-in (Search Console, GA4, Keyword Planner, Sheets). Run: python3 seo/engine/tools/gsc_pull.py auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Free keyword volumes: Google Ads Keyword Planner (needs Basic access on the developer token)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Optional paid data: this project's own DataForSEO account
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Shopify projects: Admin API custom app (write_content, write_files, read_products)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=

# Next.js projects: where the site repo is cloned, if not in project.json site_repo_path
SITE_REPO_PATH=
