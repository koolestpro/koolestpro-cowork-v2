# GPT Image Router — API Keys Example
# Copy this file to .env and fill in your keys.
# You don't need every provider. Start with the 3 minimum, add others as needed.

# ═══════════════════════════════════════════════════════════════
# MINIMUM VIABLE SET (start here)
# ═══════════════════════════════════════════════════════════════

# OpenAI — Required for image editing/compositing. Fallback for everything else.
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# inference.sh — Multi-model platform (FLUX, SDXL, video, etc.). Uses prepaid credit.
# You may already have this from video-gen/.env — same key works here.
# Get key: https://inference.sh (or reuse your video-gen key)
INFSH_API_KEY=...

# Together AI — Cheapest FLUX inference. Default for most visual work.
# Get key: https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=...

# Ideogram — Best text-in-image rendering. Default for ads with headlines.
# Get key: https://ideogram.ai/api
IDEOGRAM_API_KEY=...

# ═══════════════════════════════════════════════════════════════
# OPTIONAL EXPANSIONS (add when you need them)
# ═══════════════════════════════════════════════════════════════

# fal.ai — Highest quality FLUX (slightly better than Together).
# Get key: https://fal.ai/dashboard
FAL_KEY=...

# Recraft — Vector logos, UI mockups, style-consistent batches.
# Get key: https://recraft.ai/profile
RECRAFT_API_KEY=...

# Hyperbolic — Cheapest possible inference. Bulk batches only.
# Get key: https://app.hyperbolic.xyz/settings
HYPERBOLIC_API_KEY=...

# Stability AI — Photoreal editing, professional photography.
# Get key: https://platform.stability.ai/account/keys
STABILITY_API_KEY=...

# Google (Vertex AI / Imagen 3) — Safe, realistic people portraits.
# Get key: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=...

# ═══════════════════════════════════════════════════════════════
# OPTIONAL: PROMPT EXPANSION (--expand llm)
# ═══════════════════════════════════════════════════════════════
# Any OpenAI-compatible chat endpoint. Defaults to OpenAI + gpt-4o-mini.
# The API key falls back to OPENAI_API_KEY when not set.
# GPT_IMAGE_EXPANDER_BASE_URL=https://api.openai.com/v1
# GPT_IMAGE_EXPANDER_API_KEY=...
# GPT_IMAGE_EXPANDER_MODEL=gpt-4o-mini
